{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:failure": "vitest run tests/failure",
    "test:geometry": "vitest run tests/unit/geometry.test.ts tests/unit/normalization.test.ts",
    "test:zk:fast": "vitest run --config vitest.zk.config.ts --testNamePattern='(simple_square|l_shape|tiny_polygon)'",
    "test:zk:full": "vitest run --config vitest.zk.config.ts",
    "test:all": "vitest run --exclude tests/integration/zk-parity.test.ts",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage --ui"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/turf": "^7.3.1",
    "@types/node": "^25.0.8",
    "@types/snarkjs": "^0.7.9",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.4.0",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "big-integer": "^1.6.52",
    "leaflet": "^1.9.4",
    "snarkjs": "^0.7.5"
  }
}
